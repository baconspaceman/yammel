{
  "name": "archipelago-yaml-editor",
  "productName": "Archipelago YAML Editor",
  "version": "0.1.0",
  "description": "A desktop editor for Archipelago player YAMLs: every option, a live check count, a difficulty estimate, randomize, and an agent toolkit.",
  "license": "MIT",
  "author": "baconspaceman",
  "homepage": "https://github.com/baconspaceman/archipelago-yaml-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baconspaceman/archipelago-yaml-editor.git"
  },
  "bugs": {
    "url": "https://github.com/baconspaceman/archipelago-yaml-editor/issues"
  },
  "keywords": [
    "archipelago",
    "archipelago-multiworld",
    "randomizer",
    "yaml",
    "yaml-editor",
    "electron",
    "multiworld"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "bundle": "electron-vite build",
    "start": "electron-vite preview",
    "e2e": "electron-vite build && playwright test",
    "cli:build": "vite build --config vite.cli.config.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.11.14",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "io.github.baconspaceman.archipelago-yaml-editor",
    "productName": "Archipelago YAML Editor",
    "copyright": "Copyright (c) 2026 baconspaceman. MIT licence.",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "data/**",
      "engine/**",
      "extractor/**",
      "assets/icon/**",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!**/__pycache__/**",
      "!extractor/tests/**",
      "!engine/tests/**"
    ],
    "win": {
      "icon": "assets/icon/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Archipelago-YAML-Editor-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Archipelago-YAML-Editor-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon/icon.ico",
      "uninstallerIcon": "assets/icon/icon.ico",
      "shortcutName": "Archipelago YAML Editor"
    }
  }
}
